# Server
SERVER_PORT=9000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ymca_wellness_cafe_v2
DB_SSLMODE=disable

# Rubix
# FT name minted by each admin and transferred as reward.
FT_NAME=ytoken
# Optional: base HTTP timeout (seconds) when talking to a Rubix node
RUBIX_HTTP_TIMEOUT_SECONDS=120
# Optional: per-admin queue buffer size
QUEUE_BUFFER_SIZE=1000
# Optional: minimum gap (ms) between consecutive reward executions for the
# SAME admin, measured from the end of one to the start of the next.
# Different admins are never delayed relative to each other. 0 disables.
# Back-to-back executions on one contract crash the owner node mid-consensus
# and fork its chain (docs/INCIDENT-2026-09-04-chain-fork.md).
PAYOUT_MIN_INTERVAL_MS=1000

# Optional: read-only access to each Rubix node's own Postgres for the
# /api/debug/node/* endpoints (docs/debug-api.md). Disabled while
# NODE_DB_PASSWORD is empty. DB port = node API port + NODE_DB_PORT_OFFSET
# (yqa: node1 API 8000 -> Postgres 127.0.0.1:9000). Every session is opened read-only.
NODE_DB_HOST=127.0.0.1
NODE_DB_PORT_OFFSET=1000
NODE_DB_USER=rubix
NODE_DB_PASSWORD=
NODE_DB_NAME=rubix

# Auth (bearer tokens, RS256 JWT)
# Generate with:
#   mkdir -p keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt_private.pem
#   openssl rsa -in keys/jwt_private.pem -pubout -out keys/jwt_public.pem
#   chmod 600 keys/jwt_private.pem
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
# Token lifetimes (Go duration: 15m, 1h, 168h, etc.)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# First-boot bootstrap operator. Seeded into auth_users if the table is
# empty. Leave unset on subsequent boots — no-op if any operator exists.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
